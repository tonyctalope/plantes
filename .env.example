# Public origin of the app (https, no trailing slash). Also the OAuth issuer.
PUBLIC_URL=https://plantes.example.com

# Google OAuth client (Google Cloud console → APIs & Services → Credentials →
# OAuth client ID → Web application). Authorized redirect URI:
#   ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these Google accounts can sign in (comma separated). Removing an address
# ends its sessions and its Claude connections on the next request.
ALLOWED_EMAILS=moi@gmail.com,toi@example.org

# Household time zone (reminders, "today").
APP_TIMEZONE=Europe/Paris

# Optional: extra context given to Claude when it fills care sheets.
# HOUSEHOLD_CONTEXT=Appartement à Nantes, chauffé l'hiver. Un chat vit à la maison.

# Optional: months using the growing-season watering interval (default 4-9).
# GROWING_SEASON_MONTHS=4-9

# Optional: Web Push keys. Generated and stored in the database when unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional OAuth tuning for MCP clients.
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com          # https redirect hosts allowed for dynamic registration
# OAUTH_CIMD_HOSTS=claude.ai,claude.com,anthropic.com # hosts trusted for Client ID Metadata Documents
# OAUTH_ACCESS_TOKEN_TTL=3600
# OAUTH_REFRESH_TOKEN_TTL=7776000

# Deployment (compose.yaml)
# PLANTES_HOST=plantes.example.com
# PLANTES_UID=1000
# PLANTES_GID=1000

# Local development only (refused unless NODE_ENV=development and PUBLIC_URL is localhost):
# NODE_ENV=development
# DEV_LOGIN=1
